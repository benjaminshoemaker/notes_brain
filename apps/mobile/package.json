{
  "name": "@notesbrain/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_ROUTER_APP_ROOT=./app expo start",
    "android": "EXPO_ROUTER_APP_ROOT=./app expo start --android",
    "ios": "EXPO_ROUTER_APP_ROOT=./app expo start --ios",
    "web": "EXPO_ROUTER_APP_ROOT=./app expo start --web",
    "eas-build-post-install": "cd ../.. && npm run build -w @notesbrain/shared && cd apps/mobile && if [ -n \"$GOOGLE_SERVICES_JSON\" ] && [ -f \"$GOOGLE_SERVICES_JSON\" ]; then cp \"$GOOGLE_SERVICES_JSON\" android/app/google-services.json; elif [ -f ./google-services.json ]; then cp ./google-services.json android/app/google-services.json; fi",
    "lint": "eslint app components hooks lib services test --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@notesbrain/shared": "0.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-picker/picker": "^2.11.0",
    "@supabase/supabase-js": "^2.91.0",
    "@tanstack/react-query": "^5.87.4",
    "babel-preset-expo": "^54.0.10",
    "expo": "^54.0.0",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-mcp": "~0.2.1",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.22",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "^5.1.1",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "is-arrayish": "^0.3.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "private": true
}
